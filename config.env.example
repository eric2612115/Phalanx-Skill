# Copy to config.env and fill in user-specific values only. Do not commit config.env.
# Service/runtime settings live in service.env / service.env.example.

# Execution-side user values only. Product-shell channels are moving to DePhalanx.
# Telegram below is still used by the current compatibility runtime, but Telegram ownership is not the target long-term surface of Phalanx-Skill.
# Current compatibility flow: save token, npm run init, npm run start:compat; then use Telegram for /claim.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=  (auto-written after successful /claim; @userinfobot not required)

# OKX / onchainos — user credentials for live execution and demo
# This login email is for OKX TEE agentic wallet login and OTP receipt; Telegram setup can collect/update it.
OKX_AGENTIC_WALLET_LOGIN_EMAIL=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Managed-wallet-first runtime records the confirmed current address + simple history here after Telegram bootstrap.
# OKX_AGENTIC_WALLET_CURRENT_ADDRESS=
# OKX_AGENTIC_WALLET_ADDRESS_HISTORY=

# Preferred multi-profile registry format. Telegram/runtime should write here once the operator has
# more than one Gmail profile or more than one agentic wallet under a profile.
# OKX_AGENTIC_WALLET_PROFILES_JSON={"activeProfileId":"profile-1","activeWalletId":"wallet-1","profiles":[{"profileId":"profile-1","email":"alpha@example.com","wallets":[{"walletId":"wallet-1","address":"0x..."}]}]}
# Telegram can switch the active identity later with: `use profile <profile-id>` / `use wallet <wallet-id>`

# Optional wallet override if the user wants to pin a specific address
# PHALANX_WALLET_ADDRESS=
# AGENT_WALLET_ADDRESS=

# OmRate — user-scoped key only; service base URL lives in service.env/defaults
# Optional: omit this to exercise the paid x402 flow instead of API-key free tier access.
# OMRATE_API_KEY=

# Owner binding — required for full demo-ready
PHALANX_OWNER_EVM_ADDRESS=

# Test wallet / dry-run fallback only
TEST_WALLET_ADDRESS=

# Copy to config.env and fill in local values. Do not commit config.env.

# Runtime mode
PHALANX_ENV=development
PHALANX_RUNTIME_MODE=dry_run
PHALANX_ENABLE_MCP_STDIO=0
PHALANX_GUARDIAN_ENABLED=0
PHALANX_EXECUTION_BACKEND=

# Telegram — required: bot token. Allowed user id is auto-written on first owner claim (do not pre-fill).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=   (optional; persisted automatically after /claim)

# OKX / onchainos — required for live operator + demo
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# OmRate — optional API key; base URL defaults to https://api.omrate.com (no user input required)
# OMRATE_API_KEY=
# OMRATE_API_BASE_URL=   (optional override; default https://api.omrate.com)

# Governance + owner binding + Base execution — required for full demo-ready (human-entered)
POLICY_OWNER_KEY=
WHITELIST_POLICY_ADDRESS=
PHALANX_OWNER_EVM_ADDRESS=
BASE_RPC_URL=

# X Layer RPC defaults to official https://rpc.xlayer.tech (override only if you need a dedicated endpoint)
# XLAYER_RPC_URL=

# Test wallet / smoke
TEST_WALLET_ADDRESS=

# Optional probes (see scripts/probe-*.ts)
X402_PROBE_URL=
ONCHAINOS_PROBE_URL=

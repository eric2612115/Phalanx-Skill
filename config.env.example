# Copy to config.env and fill in user-specific values only. Do not commit config.env.
# Service/runtime settings live in service.env / service.env.example.

# Telegram — required: bot token. Allowed user id is auto-written on first owner claim.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=

# OKX / onchainos — user credentials for live operator + demo
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Optional wallet override if the user wants to pin a specific address
# PHALANX_WALLET_ADDRESS=
# AGENT_WALLET_ADDRESS=

# OmRate — user-scoped key only; service base URL lives in service.env/defaults
# OMRATE_API_KEY=

# Owner binding — required for full demo-ready
PHALANX_OWNER_EVM_ADDRESS=

# Test wallet / dry-run fallback only
TEST_WALLET_ADDRESS=

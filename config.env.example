# Copy to config.env and fill in local values. Do not commit config.env.

# Runtime mode
PHALANX_ENV=development
PHALANX_RUNTIME_MODE=dry_run
PHALANX_ENABLE_MCP_STDIO=0
PHALANX_GUARDIAN_ENABLED=0
PHALANX_EXECUTION_BACKEND=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# OKX / onchainos
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# OmRate
OMRATE_API_KEY=
OMRATE_API_BASE_URL=https://omrate.io/api

# Chain / policy
XLAYER_RPC_URL=
BASE_RPC_URL=
POLICY_OWNER_KEY=
WHITELIST_POLICY_ADDRESS=

# Test wallet / smoke
TEST_WALLET_ADDRESS=

# Optional probes (see scripts/probe-*.ts)
X402_PROBE_URL=
ONCHAINOS_PROBE_URL=

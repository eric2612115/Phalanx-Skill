# Service/runtime defaults. Copy to service.env for local overrides.
# Keep user-facing secrets and identities in config.env instead.

PHALANX_ENV=development
PHALANX_RUNTIME_MODE=live
PHALANX_ENABLE_MCP_STDIO=0
PHALANX_GUARDIAN_ENABLED=0
# PHALANX_GUARDIAN_INTERVAL_MS=14400000
# PHALANX_MEMORY_STATE_PATH=./runtime-memory.json
PHALANX_EXECUTION_BACKEND=onchainos_skill
PHALANX_REQUIRE_CHAIN_POLICY=0

# Service-owned execution and governance settings
# X Layer is the preferred product path. Keep PHALANX_X402_NETWORK only for explicit debug override.
PHALANX_X402_NETWORK=eip155:196
# PHALANX_X402_PRIVATE_KEY=
# POLICY_OWNER_KEY=
# WHITELIST_POLICY_ADDRESS=
# WHITELIST_TARGETS=uniswap-v3,pancakeswap-v3

# Static infrastructure overrides only when you need to replace code defaults
# OMRATE_API_BASE_URL=https://api.omrate.com
# BASE_RPC_URL=https://mainnet.base.org
# XLAYER_RPC_URL=https://rpc.xlayer.tech
# BSC_RPC_URL=https://bsc-dataseed.binance.org
